{
  "manifest_version": 3,
  "name": "Douyin User Video Downloader",
  "version": "1.6.1",
  "description": "Batch download Douyin and TikTok media with optional AI-translated filenames.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://douyin.com/*",
    "https://*.douyin.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "abogus.js",
        "core.js",
        "locales.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "QR.png"
      ],
      "matches": [
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Douyin User Video Downloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
